# Copy to .env. Loaded by `node --env-file=.env server.mjs`.
# Secret shown when you create the webhook in the Buy Me a Coffee dashboard.
# Until it is set, the webhook rejects every request and no supporter keys are created.
BMC_WEBHOOK_SECRET=
# Opens the private usage page at /stats?key=<this value>. Leave empty to switch the page off.
ADMIN_KEY=
# Optional overrides (defaults in server.mjs): PORT, ORIGIN, REPO_URL, COFFEE_URL, FFMPEG_BIN, WHISPER_BIN, WHISPER_MODEL, WHISPER_ARGS, POLISH_MODEL, OLLAMA_URL
