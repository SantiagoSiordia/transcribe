<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Transcribe on 127.0.0.1:3015, serves transcribe.santisiordia.com through the Cloudflare tunnel.
  Always on. Install: cp to ~/Library/LaunchAgents/ and `launchctl load` it. Paths are for this Mac; edit them for yours.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.santi.transcribe</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/santi/.nvm/versions/node/v20.19.4/bin/node</string>
    <string>--env-file=.env</string>
    <string>server.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/santi/Projects/Personal/transcribe</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/santi/Library/Logs/transcribe.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/santi/Library/Logs/transcribe.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/santi</string>
  </dict>
</dict>
</plist>
